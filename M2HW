int main() {
const double cost_per_cubic_foot = 0.30;
const double charge_per_cubic_foot = 0.52;

double length = 0.0;
double width = 0.0;
double height = 0.0;
double volume = 0.0;
double cost = 0.0;
double charge = 0.0;
double profit = 0.0;

std::cout << "Enter crate length in feet: ";
std::cin >> length;
std::cout << "Enter crate width in feet: ";
std::cin >> width;
std::cout << "Enter crate height in feet: ";
std::cin >> height;

volume = length*width*height;
cost = volume*cost_per_cubic_foot;
charge = volume*charge_per_cubic_foot;
profit = charge-cost;

std::cout << std::fixed << std::setprecision(2);

std::cout << "\n=======================================\n";
std::cout << "      General Crates Accounting        \n";
std::cout << "========================================="
std::cout << "Crate volume: " << volume << " cubic feet\n";
std::cout << "Cost to build: " << cost << "\n";
std::cout << "Customer charge: " << charge << "\n";
std::cout << "Net profit: " << profit << "\n";
std::cout << "=======================================\n";

return 0;
}




